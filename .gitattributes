# Git attributes for Green Codex
# See: https://git-scm.com/docs/gitattributes

# Text files - normalize line endings
*.md text=auto
*.txt text=auto
*.yml text=auto
yaml text=auto
*.yaml text=auto
*.json text=auto
*.html text=auto
*.css text=auto
*.js text=auto
*.py text=auto
*.sh text=auto

# Force LF line endings for these file types
*.md eol=lf
*.txt eol=lf
*.yml eol=lf
*.yaml eol=lf
*.json eol=lf
*.html eol=lf
*.css eol=lf
*.js eol=lf
*.py eol=lf
*.sh eol=lf

# Binary files - do not perform any conversions
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Diff/merge settings
*.md diff=unix
*.py diff=unix
*.sh diff=unix

# Language detection
*.md linguist-language=Markdown
*.yml linguist-language=YAML
yaml linguist-language=YAML
*.py linguist-language=Python
*.sh linguist-language=Shell
*.json linguist-language=JSON

# Merge drivers
*.md merge=union
